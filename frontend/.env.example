# Backend Hasura endpoint and admin secret (used by the login route and the
# /v1/graphql proxy). The proxy target is also read from this variable.
HASURA_GRAPHQL_ENDPOINT=http://localhost:8081
HASURA_GRAPHQL_ADMIN_SECRET=dev-admin-secret

# Secret used to sign the session JWT returned by /api/auth/login. Must be the
# same key as HASURA_GRAPHQL_JWT_SECRET on the Hasura engine.
AUTH_JWT_SECRET=dev-jwt-secret-change-me

# Actions handler endpoint (used to proxy POST /webhook/trigger).
ACTIONS_ENDPOINT=http://localhost:4000

# Frontend port (exposed for preview)
PORT=3000
