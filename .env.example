HASURA_GRAPHQL_ENDPOINT=http://localhost:8080
HASURA_GRAPHQL_ADMIN_SECRET=dev-admin-secret
HASURA_GRAPHQL_DATABASE_URL=postgres://postgres:postgres@localhost:5432/app

# Base URL the Hasura engine uses to reach the actions handler (the two Hasura
# Actions are declared as {{ACTIONS_BASE_URL}}/actions/*). In docker-compose
# this is http://actions:4000; for local dev http://localhost:4000.
ACTIONS_BASE_URL=http://localhost:4000

# JWT secret Hasura uses to validate session tokens minted by the frontend
# login route (Nhost-style auth). Must match AUTH_JWT_SECRET in the frontend.
HASURA_GRAPHQL_JWT_SECRET={"type":"HS256","key":"dev-jwt-secret-change-me"}

# Actions handler (docker-compose passes these to the `actions` service).
# WEBHOOK_TOKEN guards POST /webhook/trigger (the demo workflow "AI Release").
WEBHOOK_TOKEN=dev-webhook-token
# Base URL the actions handler uses to reach itself (used by {{env.HANDLER_BASE_URL}}).
HANDLER_BASE_URL=http://localhost:4000

# Optional real LLM backend for the `llm` step. When these are empty the llm
# step runs a deterministic simulated classifier (see README).
USER_LLM_BASE_URL=https://api.openai.com/v1
USER_LLM_API_KEY=
USER_LLM_MODEL=gpt-4o-mini
